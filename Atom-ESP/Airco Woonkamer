# mqtt, api, ota, wifi, captive, web, time
api: 
  encryption:
    key: "HIPXCLuLVPn6jpmNamCL6H8pQmLY/vHGMDcKt8omu9s="
  actions:    
    - action: reboot
      then:
        - logger.log: "Bezig met opnieuw opstarten...."
        - lambda: |-
            esp_restart();
    - action: set_remote_temperature
      variables:
        temperature: float
      then:
        - lambda: 'id(atoms3_clim).set_remote_temperature(temperature);'

    - action: use_internal_temperature
      then:
        - lambda: 'id(atoms3_clim).set_remote_temperature(0);'
    


ota:
