views:
  - type: sections
    path: ''
    sections:
      - type: grid
        cards:
          - type: heading
            heading_style: title
            heading: Status
          - type: glance
            entities:
              - entity: device_tracker.10063a1aa0cfebcb_bermuda_tracker
                name: Anita
              - entity: sensor.10063a1aa0cfebcb_area
                name: Anita
              - entity: device_tracker.1006381ee03fc933_bermuda_tracker
                name: Rients
              - entity: sensor.1006381ee03fc933_area
                name: Rients
            grid_options:
              columns: 12
              rows: auto
          - type: glance
            entities:
              - entity: binary_sensor.motion_kantoor_motion
                name: Kantoor
              - entity: binary_sensor.motion_zolder_motion
                name: Zolder
              - entity: binary_sensor.aanwezigheid_kamer_presence
                name: Kamer
            grid_options:
              columns: 12
              rows: auto
          - type: glance
            entities:
              - entity: input_boolean.status_anita_ver_weg
                name: ABV verweg
              - entity: input_boolean.status_rients_ver_weg
                name: RMB verweg
              - entity: input_boolean.status_niet_thuis
                name: We zijn niet thuis
            grid_options:
              columns: 12
              rows: auto
            visibility:
              - condition: state
                entity: input_boolean.status_anita_ver_weg
                state: 'on'
              - condition: state
                entity: input_boolean.status_rients_ver_weg
                state: 'on'
          - type: glance
            entities:
              - entity: sensor.p1_meter_power
              - entity: sensor.marstek_m1_battery_state_of_charge
                name: Thuis Bat Status
              - entity: sensor.marstek_m1_battery_power
                name: Batterij Power
            visibility:
              - condition: state
                entity: sensor.marstek_m1_device_name
                state_not: unknown
            grid_options:
              columns: 12
              rows: auto
        column_span: 3
      - type: grid
        cards:
          - type: heading
            heading_style: title
            heading: Huidige Energie
            icon: mdi:lightning-bolt
          - type: history-graph
            entities:
              - entity: sensor.l1_fase_1
                name: MK/BEN/BOV/OVEN
              - entity: sensor.l1_fase_2
                name: BOY/VAAT/HAL/TA
              - entity: sensor.l1_fase_3
                name: IND/WAS
              - entity: input_text.house_battery_strategy_active_sub_strategy
                name: Execute
            hours_to_show: 0.05
            logarithmic_scale: false
          - type: history-graph
            entities:
              - entity: input_number.house_battery_control_pid_output
                name: PID control
              - entity: sensor.p1_meter_power
                name: Grid power
              - entity: select.marstek_m1_forcible_charge_discharge
                name: M1
              - entity: select.marstek_m2_forcible_charge_discharge
                name: M2
              - entity: select.marstek_m3_forcible_charge_discharge
                name: M3
              - entity: select.marstek_m4_forcible_charge_discharge
                name: M4
            hours_to_show: 0.05
          - type: entities
            entities:
              - entity: sensor.l1_fase_1
                name: Fase 1 (act)
              - entity: input_number.l1_meter_max
                name: fase 1 (max)
              - entity: sensor.l1_fase_2
                name: Fase 2 (act)
              - entity: input_number.l1_fase_2_max
                name: fase 2 (max)
              - entity: sensor.l1_fase_3
                name: Fase 3 (act)
              - entity: input_number.l1_fase_3_max
                name: fase 3 (max)
            title: Fase(s)
        column_span: 3
    title: Status
    cards: []
    icon: mdi:folder-home
    subview: false
    max_columns: 4
    header:
      layout: center
      badges_position: bottom
      badges_wrap: wrap
    badges:
      - type: entity
        show_name: true
        show_state: true
        show_icon: true
        entity: input_select.house_battery_strategy
        name: Choose strategy
        tap_action:
          action: more-info
      - type: entity
        show_name: true
        show_state: true
        show_icon: true
        entity: input_text.house_battery_strategy_active_sub_strategy
        show_entity_picture: false
        name: Executing
  - type: sections
    max_columns: 4
    title: Schakelaar
    path: schakelaar
    icon: mdi:electric-switch
    sections:
      - type: grid
        cards:
          - type: heading
            heading: Schakelaars
            heading_style: title
          - type: glance
            entities:
              - entity: switch.schemerlamp
                name: Schemer
                tap_action:
                  action: toggle
              - entity: switch.schemerlamp_anita
                name: LP Anita
                tap_action:
                  action: toggle
              - entity: switch.shelly_vriezer
                name: TV-meub
                tap_action:
                  action: toggle
              - entity: switch.zigbee_kantoor
                name: Kantoor
                tap_action:
                  action: toggle
            visibility:
              - condition: state
                entity: sensor.marstek_m1_device_name
                state_not: unknown
            grid_options:
              columns: 12
              rows: auto
          - type: glance
            entities:
              - entity: switch.zigbee_tvzolder
                name: TV-zolder
                tap_action:
                  action: toggle
              - entity: switch.shelly_zolder
                name: Scherm Zolder
                tap_action:
                  action: toggle
              - entity: switch.shelly_nuc
                name: USB Backup
                tap_action:
                  action: toggle
              - entity: input_boolean.thermostaat_regelen
                name: Termostaat Regelen
                tap_action:
                  action: toggle
            visibility:
              - condition: state
                entity: sensor.marstek_m1_device_name
                state_not: unknown
            grid_options:
              columns: 12
              rows: auto
          - type: tile
            entity: light.woonkamer_2
            features_position: bottom
            vertical: false
          - type: tile
            entity: light.eethoek_2
          - type: tile
            entity: light.keuken
        column_span: 1
      - type: grid
        cards:
          - type: heading
            heading: Verwarming
            heading_style: title
          - type: thermostat
            entity: climate.woonkamer
            show_current_as_primary: true
            features:
              - type: climate-hvac-modes
            layout_options:
              grid_columns: 2
              grid_rows: 4
          - type: thermostat
            entity: climate.zolder
            layout_options:
              grid_columns: 2
              grid_rows: 4
            features:
              - type: climate-hvac-modes
            show_current_as_primary: true
  - type: sections
    max_columns: 4
    title: Energie
    path: energie
    icon: mdi:transmission-tower
    sections:
      - type: grid
        cards:
          - type: heading
            heading_style: title
            heading: 'Energie Palladiostraat '
          - title: Energiedistributie vandaag
            type: energy-distribution
            link_dashboard: true
          - type: history-graph
            entities:
              - entity: sensor.p1_meter_power
                name: Net belasting
            hours_to_show: 0.05
            logarithmic_scale: false
          - type: history-graph
            entities:
              - entity: sensor.l1_fase_1
                name: MK/BEN/BOV/OVEN
              - entity: sensor.l1_fase_2
                name: BOY/VAAT/HAL/TA
              - entity: sensor.l1_fase_3
                name: IND/WASM
            hours_to_show: 0.05
            logarithmic_scale: false
          - type: gauge
            entity: sensor.l1_fase_1
            name: Fase 1
            needle: true
            min: 0
            max: 3600
            severity:
              green: 0
              yellow: 2300
              red: 3000
            grid_options:
              columns: 4
              rows: auto
            theme: Mushroom Shadow
          - type: gauge
            entity: sensor.l1_fase_2
            needle: true
            min: 0
            max: 3600
            severity:
              green: 0
              yellow: 2300
              red: 3000
            grid_options:
              columns: 4
              rows: auto
            theme: Mushroom Shadow
            name: Fase 2
          - type: gauge
            entity: sensor.l1_fase_3
            needle: true
            min: 0
            max: 3600
            severity:
              green: 0
              yellow: 2300
              red: 3000
            grid_options:
              columns: 4
              rows: auto
            theme: Mushroom Shadow
            name: Fase 3
