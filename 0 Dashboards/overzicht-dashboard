            badges: []
            icon: mdi:list-status
          - type: custom:bubble-card
            card_type: sub-buttons
            button_type: switch
            sub_button:
              main: []
              bottom:
                - name: Automatically grouped
                  buttons_layout: inline
                  group:
                    - entity: sensor.p1_meter_power
                      content_layout: icon-bottom
                      fill_width: false
                      name: P1
                      state_content: state
                    - entity: sensor.marstek_m1_battery_state_of_charge
                      fill_width: false
                      content_layout: icon-bottom
                      name: Bat %
                      state_content: state
                    - entity: sensor.marstek_m1_ac_power
                      fill_width: false
                      name: Bat Charge
                      content_layout: icon-bottom
                      icon: mdi:battery-charging
                      show_name: false
                      force_icon: false
                      show_icon: true
                      state_background: true
                      state_content: state
                    - entity: sensor.l1_fase_1
                      fill_width: false
                      name: F1
                      show_name: false
                      content_layout: icon-bottom
                      state_content: state
                    - entity: sensor.l1_fase_2
                      fill_width: false
                      name: F2
                      show_name: false
                      content_layout: icon-bottom
                      state_content: state
                    - entity: sensor.l1_fase_3
                      fill_width: false
                      name: F3
                      show_name: false
                      content_layout: icon-bottom
                      state_content: state
                  justify_content: start
            slider_fill_orientation: left
            slider_value_position: right
            entity: device_tracker.private_ble_device_09648c
            rows: 0.938
            hide_main_background: false
            footer_mode: false
